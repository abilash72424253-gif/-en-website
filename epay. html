<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>E-PAY PRO</title>
<style>
body{font-family:Arial;background:#0f0f0f;color:white;padding:15px;text-align:center}
h1{color:#00ff88}
.box{background:#1e1e1e;padding:15px;border-radius:15px;margin:10px 0}
input{width:95%;padding:12px;border-radius:10px;border:none;margin:5px 0}
button{width:100%;padding:13px;border:none;border-radius:10px;background:#00ff88;font-weight:bold;margin:5px 0}
.btn2{background:#ffcc00}
.history{background:#2a2a2a;padding:10px;border-radius:10px;text-align:left}
</style>
</head>
<body>
<h1>E-PAY 💸 PRO</h1>
<p>Vanakkam Abilash! 🔥</p>
<div class="box">
<p>En Balance</p>
<h2 id="bal">₹ 0</h2>
<button class="btn2" onclick="addMoney()">+ ADD MONEY</button>
<button onclick="scan()">📷 SCAN & PAY</button>
</div>
<div class="box">
<h3>Send Money</h3>
<input id="name" placeholder="Yaarukku? Peru">
<input id="amt" type="number" placeholder="Evlo? Amount">
<button onclick="send()">SEND ➡️</button>
</div>
<div class="history" id="hist"><b>History:</b><br>No transactions yet</div>
<script>
let bal=parseInt(localStorage.getItem('bal')||0);
let hist=localStorage.getItem('hist')||'';
function show(){document.getElementById('bal').innerText='₹ '+bal;document.getElementById('hist').innerHTML='<b>History:</b><br>'+(hist||'No transactions yet');}
function addMoney(){let a=prompt('Evlo add panna?');if(a){bal+=parseInt(a);hist+='✅ +₹'+a+' Added<br>';save();}}
function send(){let n=document.getElementById('name').value;let a=document.getElementById('amt').value;if(!n||!a)return alert('Peru & Amount podu machi!');if(a>bal)return alert('Balance illa machi!');bal-=a;hist+='➡️ ₹'+a+' to '+n+'<br>';save();alert('Sent ₹'+a+' to '+n); }
function scan(){alert('Camera open aagum - QR scan panni pay pannalam!');}
function save(){localStorage.setItem('bal',bal);localStorage.setItem('hist',hist);show();}
show();
</script>
</body>
</html>
